# Local API server settings
HOST=127.0.0.1
PORT=8000

# Set a long random token before exposing the general session API publicly.
# When unset, local development endpoints remain unauthenticated.
API_AUTH_TOKEN=

# REQUIRED for the Retell custom-function endpoint. Configure the same secret
# in Retell's custom function authentication/header settings.
RETELL_WEBHOOK_SECRET=

# WARNING: qualification sessions are in memory and reset when the process restarts.
# Do not run multiple workers until persistent shared session storage is implemented.
